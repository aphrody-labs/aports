# Maintainer: aphrody-dev <yohanpierre15@gmail.com>
#
# The libcosmic window and notification helper of bun:cosmic (aphrody-labs/bun,
# packages/bun-cosmic). bun:cosmic finds it in PATH as `bun-cosmic`. Built from the three files
# of the helper at a pushed bun commit, not from the whole bun tree. Same libcosmic revision as
# the COSMIC 1.10.0 apps (cosmic-osk, cosmic-viewer); libcosmic is linked statically.
maintainer="aphrody-dev <yohanpierre15@gmail.com>"
pkgname=bun-cosmic
pkgver=0.1.0_git20261009
_commit=afc5000b62a07a9b241418e67e3920cd71c20d22
pkgrel=0
pkgdesc="libcosmic window and desktop notification helper for bun:cosmic"
url="https://github.com/aphrody-labs/bun/tree/main/packages/bun-cosmic"
# Same architectures as the rest of the Aphrody COSMIC desktop.
arch="aarch64 x86_64"
license="MIT"
makedepends="
	cargo-auditable
	libxkbcommon-dev
"
options="net !check"  # fetch dependencies, the helper has no tests (bun:cosmic tests drive it)
_raw="https://raw.githubusercontent.com/aphrody-labs/bun/$_commit/packages/bun-cosmic"
source="
	bun-cosmic-Cargo.toml::$_raw/Cargo.toml
	bun-cosmic-Cargo.lock::$_raw/Cargo.lock
	bun-cosmic-main.rs::$_raw/src/main.rs
"
builddir="$srcdir/bun-cosmic"

prepare() {
	mkdir -p "$builddir/src"
	cp "$srcdir/bun-cosmic-Cargo.toml" "$builddir/Cargo.toml"
	cp "$srcdir/bun-cosmic-Cargo.lock" "$builddir/Cargo.lock"
	cp "$srcdir/bun-cosmic-main.rs" "$builddir/src/main.rs"
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

package() {
	install -Dm755 target/release/bun-cosmic -t "$pkgdir"/usr/bin/
}

sha512sums="
