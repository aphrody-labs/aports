a4379fa440abf7089897959045ab45ebb94401570866c817449c8be5b9f3d53e0e5cdc707b876186347e9a567a6ada0e06ae70a77bd3d7dc010b018d8807a95a  system76-scheduler.initd
68710aafb362a4da22dcbb6cf497d615f3d5bda6e25e79bfd8ae95213301f9a33ea5d78ce216eb7cc135a96d477afe367fc557264bfa1371c3f20954d4f52d0a  musl-sched-param.patch
"
