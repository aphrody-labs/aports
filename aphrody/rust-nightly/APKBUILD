# Maintainer: aphrody-dev <yohanpierre15@gmail.com>
#
# The Rust nightly pinned by aphrody-labs/bun's rust-toolchain.toml, repackaged from the official
# musl-host dist tarballs into /usr/lib/rust-nightly (PATH=/usr/lib/rust-nightly/bin:...). It sits
# beside Alpine's `rust`, never replaces it. Bump _date with rust-toolchain.toml, then
# `abuild checksum`.
pkgname=rust-nightly
_date=2026-09-15
pkgver=0_git20260915
pkgrel=0
pkgdesc="Rust nightly toolchain $_date (rustc, cargo, std, rust-src, clippy, rustfmt, llvm-tools)"
url="https://www.rust-lang.org/"
arch="x86_64 aarch64"
license="Apache-2.0 OR MIT"
depends="gcc musl-dev"
options="!strip !check !tracedeps"
_triple="$CARCH-unknown-linux-musl"
source="rust-nightly-$_date-$CARCH.tar.xz::https://static.rust-lang.org/dist/$_date/rust-nightly-$_triple.tar.xz
	rust-src-nightly-$_date.tar.xz::https://static.rust-lang.org/dist/$_date/rust-src-nightly.tar.xz
	"
_prefix=/usr/lib/rust-nightly

package() {
	"$srcdir"/rust-nightly-$_triple/install.sh \
		--prefix=$_prefix --destdir="$pkgdir" --disable-ldconfig \
		--components=rustc,cargo,rust-std-$_triple,clippy-preview,rustfmt-preview,llvm-tools-preview
	"$srcdir"/rust-src-nightly/install.sh \
		--prefix=$_prefix --destdir="$pkgdir" --disable-ldconfig
	rm -f "$pkgdir"$_prefix/lib/rustlib/install.log "$pkgdir"$_prefix/lib/rustlib/uninstall.sh
}

sha512sums=""
