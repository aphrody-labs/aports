# Maintainer: aphrody-dev <yohanpierre15@gmail.com>
#
# Bun from the aphrody-labs/bun fork: the musl release binary (built natively on Alpine by the
# fork's release workflow), repackaged. Subpackages:
#   bun-shell  bunsh (Bun Shell as a login/system shell) + /etc/shells
#   bun-apk    apk <-> bun: npm packages shipped as apks live in /usr/lib/bun/node_modules and an apk
#              trigger (run by bun) links their bins into /usr/lib/bun/bin; `bun add -g` installs to
#              /usr/local/lib/bun (excluded from `apk audit`); one install cache, /var/cache/bun.
#              apk already execve()s scripts and triggers (shebang honoured), so this needs no
#              apk-tools patch.
pkgname=bun
# bunsh (bun-shell) needs a release newer than 1.4.3-aphrody.2: bump _tag/pkgver, then `abuild checksum`.
_tag=1.4.3-aphrody.2
pkgver=1.4.3_p2
pkgrel=0
pkgdesc="Fast all-in-one JavaScript runtime, bundler, test runner and package manager (Aphrody fork)"
url="https://github.com/aphrody-labs/bun"
arch="x86_64 aarch64"
license="MIT"
depends="libgcc libstdc++"
subpackages="$pkgname-shell:shell:noarch $pkgname-apk:apk:noarch"
install="$pkgname-shell.post-install $pkgname-shell.pre-deinstall"
triggers="$pkgname-apk.trigger=/usr/lib/bun/node_modules/*"
options="!strip !check"

case "$CARCH" in
x86_64) _arch=x64 ;;
aarch64) _arch=aarch64 ;;
esac
source="bun-$_tag-$CARCH.zip::https://github.com/aphrody-labs/bun/releases/download/aphrody-v$_tag/bun-linux-$_arch-musl.zip
	bun.profile
	bun-global.list
	"
builddir="$srcdir/bun-linux-$_arch-musl"

package() {
	install -Dm755 "$builddir"/bun "$pkgdir"/usr/bin/bun
	ln -s bun "$pkgdir"/usr/bin/bunx
}

shell() {
	pkgdesc="Bun Shell as a login and system shell (bunsh)"
	depends="$pkgname=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"/bin
	ln -s /usr/bin/bun "$subpkgdir"/bin/bunsh
}

apk() {
	pkgdesc="apk integration for bun: shared install cache, global packages, apk trigger"
	depends="$pkgname=$pkgver-r$pkgrel"
	install -Dm644 "$srcdir"/bun.profile "$subpkgdir"/etc/profile.d/bun.sh
	install -Dm644 "$srcdir"/bun-global.list "$subpkgdir"/etc/apk/protected_paths.d/bun-global.list
	install -dm755 "$subpkgdir"/usr/lib/bun/node_modules "$subpkgdir"/usr/lib/bun/bin 		"$subpkgdir"/usr/local/lib/bun/global "$subpkgdir"/var/cache/bun/install
}

