# Contributor: Clayton Craft <clayton@craftyguy.net>
# Backport to 3.24 of aports master community/cosmic-osk (commit cbc8344575b9,
# COSMIC epoch 1.10.0). New in edge: 3.24 community has the other COSMIC 1.0.15 packages, not this one.
# https://github.com/alpinelinux/aports/blob/cbc8344575b90a7a5aa7c711aabd4f3c69368e55/community/cosmic-osk/APKBUILD
# Aphrody changes: none besides the maintainer; builds with 3.24 rust 1.96 (COSMIC needs >= 1.93);
# libcosmic is linked statically, so it runs next to the 1.0.15 session.
# Original maintainer: team/cosmic (Clayton Craft).
# Maintainer: aphrody-dev <yohanpierre15@gmail.com>
maintainer="aphrody-dev <yohanpierre15@gmail.com>"
pkgname=cosmic-osk
pkgver=1.10.0
_upstreamver="${pkgver/_beta/-beta.}"
_upstreamver="${_upstreamver/_p/.}"
pkgrel=0
pkgdesc="On-screen keyboard for the COSMIC Desktop Environment"
url="https://github.com/pop-os/cosmic-osk"
# armv7, armhf, x86: DO NOT RE-ENABLE! 32-bit is problematic, often requires carrying patches to fix
# riscv64: too slow to build
# ppc64le, s390x: DO NOT RE-ENABLE: rustix fails often on this arch
arch="aarch64 loongarch64 x86_64"
license="GPL-3.0-only"
depends="
	cosmic-icons
"
makedepends="
	cargo-auditable
	just
	eudev-dev
	libxkbcommon-dev
"
options="net !check"  # fetch dependencies, no tests
source="
	$pkgname-$pkgver.tar.gz::https://github.com/pop-os/cosmic-osk/archive/refs/tags/epoch-$_upstreamver.tar.gz
"
builddir="$srcdir/$pkgname-epoch-$_upstreamver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	just rootdir="$pkgdir" install
}

sha512sums="
d2be3c3e510a96c3bc4a2a4799446f6393875743c28bedaf2eb4ebe49ac4e85a19a6cbb4502b433c9782dcb65b4ed3588d9bbfbf3975e558597c775572bd9b3a  cosmic-osk-1.10.0.tar.gz
"
