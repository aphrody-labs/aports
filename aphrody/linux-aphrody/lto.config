# Optional Clang ThinLTO, merged last when the APKBUILD runs with APHRODY_KERNEL_LTO=1.
# Not in the default images: in 6.18, RUST requires !DEBUG_INFO_BTF || !LTO and GENDWARFKSYMS
# requires !LTO, so ThinLTO with Rust drops BTF (and with it sched_ext and CO-RE tools) and
# module symbol versioning. check-config.ts applies this file when the running kernel has
# CONFIG_LTO_CLANG_THIN=y.

# Cross-unit inlining of the syscall, network and memory paths Bun uses (LLVM=1 only).
CONFIG_LTO_CLANG_THIN=y
# Incompatible with RUST under LTO.
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# sched_ext depends on DEBUG_INFO_BTF.
# CONFIG_SCHED_CLASS_EXT is not set
# GENDWARFKSYMS needs !LTO, so RUST needs MODVERSIONS off.
# CONFIG_MODVERSIONS is not set
# CONFIG_EXTENDED_MODVERSIONS is not set
# CONFIG_GENDWARFKSYMS is not set
