# New package: llvm-mingw is in neither aports 3.24-stable nor edge.
#
# Aphrody: the Windows cross toolchain that replaces MSYS2's mingw-w64-ucrt-x86_64-gcc
# (C:\bun\docs\aphrody\merge\M-msys2.md). No LLVM of its own: build-all.sh --host-clang
# wraps the system clang/lld of the pinned LLVM suite, then builds mingw-w64 (headers,
# ucrt CRT, winpthreads), compiler-rt, libunwind, libc++ and openmp for each target.
# Windows packages built with it use CARCH=windows-<cpu> (see mingw-w64-* recipes).
# Maintainer: aphrody-dev <yohanpierre15@gmail.com>
maintainer="aphrody-dev <yohanpierre15@gmail.com>"
pkgname=llvm-mingw
pkgver=20261006
pkgrel=0
_llvmver=23
_llvmfull=23.1.3
# MINGW_W64_VERSION pinned by build-mingw-w64.sh at tag $pkgver
_mingwcommit=a3d93999ef0521681d45e445c39964a7af0f593f
_targets="x86_64 aarch64"
pkgdesc="LLVM/Clang/LLD based mingw-w64 cross toolchain (UCRT) on the system clang"
url="https://github.com/aphrody-labs/llvm-mingw"
arch="x86_64 aarch64"
license="ISC AND ZPL-2.1 AND Apache-2.0 WITH LLVM-exception"
depends="clang$_llvmver lld$_llvmver llvm$_llvmver"
makedepends="
	clang$_llvmver
	cmake
	coreutils
	git
	lld$_llvmver
	llvm$_llvmver
	make
	python3
	samurai
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/aphrody-labs/llvm-mingw/archive/refs/tags/$pkgver.tar.gz
	mingw-w64-$_mingwcommit.tar.gz::https://github.com/aphrody-labs/mingw-w64/archive/$_mingwcommit.tar.gz
	https://github.com/llvm/llvm-project/releases/download/llvmorg-$_llvmfull/llvm-project-$_llvmfull.src.tar.xz
	"
builddir="$srcdir/$pkgname-$pkgver"
# check: the smoke test in check() needs no network; strip: target libraries are PE/COFF
options="!strip"

prepare() {
	default_prepare
	ln -sfn "$srcdir/mingw-w64-$_mingwcommit" mingw-w64
	ln -sfn "$srcdir/llvm-project-$_llvmfull.src" llvm-project
}

build() {
	export PATH="/usr/lib/llvm$_llvmver/bin:$PATH"
	TOOLCHAIN_ARCHS="$_targets" ./build-all.sh "$srcdir/out" \
		--host-clang=clang --with-default-msvcrt=ucrt --disable-cfguard
}

check() {
	local t
	for t in $_targets; do
		"$srcdir"/out/bin/$t-w64-mingw32-clang -O2 -o "$srcdir"/hello-$t.exe test/hello.c
		"$srcdir"/out/bin/$t-w64-mingw32-clang++ -O2 -std=c++20 -o "$srcdir"/hello-cpp-$t.exe test/hello-cpp.cpp
		"$srcdir"/out/bin/llvm-readobj --coff-imports "$srcdir"/hello-cpp-$t.exe \
			| grep -q 'Name: libc++.dll'
	done
}

package() {
	mkdir -p "$pkgdir"/usr/lib "$pkgdir"/usr/bin
	cp -a "$srcdir"/out "$pkgdir"/usr/lib/llvm-mingw
	local f
	for f in "$pkgdir"/usr/lib/llvm-mingw/bin/*-w64-mingw32-*; do
		ln -s ../lib/llvm-mingw/bin/"${f##*/}" "$pkgdir"/usr/bin/"${f##*/}"
	done
}
sha512sums="
