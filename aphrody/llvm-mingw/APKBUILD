b247c42068caaf66608b0dac4af70b4ba9b75c2a87e99218c036a2d395a93f623c5405d7002c36e5a55e9ac35fbc9ab89b02379c0b30f985fe9b7efd7b2a401b  mingw-w64-a3d93999ef0521681d45e445c39964a7af0f593f.tar.gz
eb76f37804564a2595ca8de4864e96cf13c0a3f07922f6bce4d11771547525785c0fde54457aadf7aa1bcaac496475f1dde00e1b152c1df560669c6e3e1318bf  llvm-project-23.1.3.src.tar.xz
"
