# Maintainer: aphrody-dev <yohanpierre15@gmail.com>
maintainer="aphrody-dev <yohanpierre15@gmail.com>"
pkgname=aphrody-sysctl
pkgver=1.1
pkgrel=1
pkgdesc="Aphrody Alpine: sysctls and limits for Bun (network, memory, inotify, perf, io_uring), boot modules"
url="https://github.com/aphrody-labs/aports"
arch="noarch"
license="MIT"
depends="busybox"
subpackages="$pkgname-server:server:noarch"
source="90-aphrody-bun.conf
	aphrody-bun.limits.conf
	aphrody.modules-load.conf
	aphrody-server.sysctl.conf
	"
install="$pkgname.post-install $pkgname.post-upgrade
	$pkgname-server.post-install $pkgname-server.post-upgrade"
options="!check"

package() {
	install -Dm644 "$srcdir"/90-aphrody-bun.conf "$pkgdir"/etc/sysctl.d/90-aphrody-bun.conf
	install -Dm644 "$srcdir"/aphrody-bun.limits.conf "$pkgdir"/etc/security/limits.d/90-aphrody-bun.conf
	install -Dm644 "$srcdir"/aphrody.modules-load.conf "$pkgdir"/etc/modules-load.d/aphrody.conf
}

server() {
	pkgdesc="Aphrody Alpine: production server sysctls (VPS backlog, buffers, no-zram memory, hardening)"
	depends="$pkgname=$pkgver-r$pkgrel"
	install -Dm644 "$srcdir"/aphrody-server.sysctl.conf "$subpkgdir"/etc/sysctl.d/91-aphrody-server.conf
}

