# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=rhythmbox
pkgver=3.5.1
pkgrel=0
pkgdesc="GNOME audio player"
url="https://gitlab.gnome.org/GNOME/rhythmbox"
arch="all"
license="GPL-2.0-or-later"
depends_dev="gnome-desktop-dev libpeas-dev"
makedepends="
	$depends_dev
	appstream-glib
	brasero-dev
	cmake
	desktop-file-utils
	docbook-xml
	docbook-xsl
	gmime-dev
	grilo-dev
	gst-plugins-base-dev
	gstreamer-dev
	itstool
	json-glib-dev
	libgpod-dev
	libgudev-dev
	libmtp-dev
	libnotify-dev
	lirc-dev
	libsecret-dev
	libsoup3-dev
	libxml2-utils
	libxslt
	meson
	py3-gobject3-dev
	tdb-dev
	totem-pl-parser-dev
	vala
	"
subpackages="$pkgname-dev $pkgname-doc $pkgname-lang"
source="https://download.gnome.org/sources/rhythmbox/${pkgver%.*}/rhythmbox-$pkgver.tar.xz"

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
bc239737595a39e00f71247b130b6dd6a6c6a900cb7460d743338affc748e2abab079e320e82f5877e9747d369784f67a5aca89d7be50e4230b7f139893bbce2  rhythmbox-3.5.1.tar.xz
"
