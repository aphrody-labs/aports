# Contributor: ScrumpyJack <scrumpyjack@st.ilet.to>
# Maintainer: ScrumpyJack <scrumpyjack@st.ilet.to>
pkgname=geeqie
pkgver=3.3
pkgrel=0
pkgdesc="Gtk+ based image viewer and organiser"
url="http://www.geeqie.org/"
arch="all"
license="GPL-2.0-only"
makedepends="
	doxygen
	exiv2-dev
	graphviz-dev
	gtk4.0-dev
	lcms2-dev
	libarchive-dev
	lua5.3-dev
	meson
	xxd
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-doc
	$pkgname-lang
	"
source="https://github.com/BestImageViewer/geeqie/releases/download/v$pkgver/geeqie-$pkgver.tar.xz"
options="!check" # no tests

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
230c85f8edc654ef6d9e304811dc2c7efa9558867005a722283165435c0e435773c2e43a44ead000a6ab1ebacc7e84e626f2de18153efcddf2e8d758ed682d8a  geeqie-3.3.tar.xz
"
