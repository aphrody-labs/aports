3545d3aa5751e0326a72381a3ec81ab4fd1c5cc0fc8a4bb9a671700087b25f8136bd61e74c3bed5b45164e78b8a534e95278756a3573f15e4224d2ccf710fe4b  no-telemetry.patch
"
