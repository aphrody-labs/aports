# Contributor: Sora Morimoto <sora@morimoto.io>
# Contributor: Anil Madhavapeddy <anil@recoil.org>
# Contributor: omni <omni+alpine@hack.org>
# Maintainer: Kate <kit-ty-kate@exn.st>
pkgname=opam
pkgver=2.6.1
pkgrel=0
pkgdesc="OCaml Package Manager"
url="https://opam.ocaml.org"
arch="all"
license="LGPL-2.1-only WITH OCaml-LGPL-linking-exception"
depends="curl tar unzip coreutils rsync bash bubblewrap"
options="!check" # The tests use bubblewrap which cannot be run inside docker
makedepends="dune ocaml-compiler-libs"
checkdepends="diffutils ocaml-micro_httpd"
source="https://github.com/ocaml/opam/releases/download/$pkgver/opam-full-$pkgver.tar.gz"
subpackages="$pkgname-doc"
builddir="$srcdir/opam-full-$pkgver"

# secfixes:
#   2.5.2-r0:
#     - CVE-2026-57825

case "$CARCH" in
	riscv64|loongarch64)
		makedepends="${makedepends//ocaml/ocaml5}"
		;;
esac

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--with-mccs \
		--with-vendored-deps \
		--with-dune=/usr/bin/dune

	make -j1 all
}

check() {
	make tests
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}

sha512sums="
9425c2129f5b42477b4bafbb53c134724f48091d9972cda85e6d4f94966253f9c9e648f3cd884c0a638662c1696efe8ca7618db5361fa663027dca7db0e6290a  opam-full-2.6.1.tar.gz
"
