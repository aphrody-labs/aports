maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=picard
pkgver=3.0
pkgrel=0
# armhf blocked by qt6-qtdeclarative -> py3-qt6
arch="all !armhf"
url="https://picard.musicbrainz.org/"
pkgdesc="Official MusicBrainz tagger"
license="GPL-2.0-or-later"
depends="
	chromaprint
	py3-dateutil
	py3-fasteners
	py3-mutagen
	py3-qt6
	py3-yaml
	qt6-qtimageformats
	"
makedepends="
	gettext
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
checkdepends="py3-pytest"
subpackages="
	$pkgname-lang
	$pkgname-pyc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/metabrainz/picard/archive/refs/tags/release-$pkgver.tar.gz"
builddir="$srcdir/picard-release-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

lang() {
	local pyver=$(python3 -V | sed 's/.*\([0-9]\{1,\}\.[0-9]\{1,\}\)\..*/\1/')
	amove usr/lib/python$pyver/site-packages/picard/locale/
}

sha512sums="
bd917eda24904b6ff63c77af78a8e4e85c358ace67ac37587bd2526b10edfe2ac308e17ca7562e266a95be5b5f19bcba5ef04a38c37da18a58008d374198ff6d  picard-3.0.tar.gz
"
