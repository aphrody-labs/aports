# Contributor: Noel Kuntze <noel.kuntze@thermi.consulting>
# Maintainer: Noel Kuntze <noel.kuntze@thermi.consulting>
pkgname=py3-sqlmodel
pkgver=0.0.46
pkgrel=0
pkgdesc="SQL databases in Python, designed for simplicity, compatibility, and robustness"
url="https://sqlmodel.tiangolo.com"
arch="noarch"
license="MIT"
depends="
	py3-alembic
	py3-pydantic
	py3-sqlalchemy
	py3-typing-extensions
	pre-commit
	"
makedepends="
	py3-gpep517
	py3-wheel
	py3-pdm-backend
	"
checkdepends="
	py3-coverage
	py3-dirty-equals
	py3-fastapi
	py3-httpx
	py3-pytest
	py3-typer
	"
subpackages="$pkgname-pyc"

source="$pkgname-$pkgver.tar.gz::https://github.com/fastapi/sqlmodel/archive/refs/tags/$pkgver.tar.gz"

builddir="$srcdir/sqlmodel-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir dist \
		--output-fd 3 3>&1 >&2
}

check() {
	local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
	python3 -m installer -d test_dir dist/*.whl
	export PYTHONPATH="$PWD/test_dir/$_site_packages:$PYTHONPATH"

	# Remove failing tests relying on old python versions
	rm -rf tests/test_select_gen.py \
		tests/test_tutorial/test_create_db_and_table/test_tutorial001*.py

	pytest -vv tests/
}

package() {
	python -m installer -d "$pkgdir" dist/*.whl
}

sha512sums="
022e1fff5bf6e4f38f6d4a5b40965089125ddcb8dd42fb2915311d832180a5b4aacd4c3c78d01423c694677646756bd340e24dac024a40af99a5d42a33cf30af  py3-sqlmodel-0.0.46.tar.gz
"
