maintainer="Hannes Braun <hannes@hannesbraun.net>"
pkgname=supmover
pkgver=2.5.2
pkgrel=0
pkgdesc="Shift timings and screen areas of PGS/SUP subtitles"
url="https://github.com/MonoS/SupMover"
arch="all"
license="AGPL-3.0-only"
source="https://github.com/MonoS/SupMover/archive/v$pkgver/supmover-$pkgver.tar.gz"
builddir="$srcdir/SupMover-$pkgver"
options="!check" # no tests

build() {
	g++ $CXXFLAGS -std=c++17 -o supmover main.cpp
}

package() {
	install -Dm755 supmover -t "$pkgdir"/usr/bin
}

