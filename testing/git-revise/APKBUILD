# Maintainer:
pkgname=git-revise
pkgver=0.8.0
pkgrel=0
pkgdesc="Handy tool for doing efficient in-memory commit rebases & fixups with git"
url="https://github.com/mystor/git-revise"
arch="noarch"
license="MIT"
depends="python3 git"
makedepends="py3-gpep517 py3-hatchling"
checkdepends="openssh-client-default py3-pytest"
subpackages="$pkgname-doc $pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/mystor/git-revise/archive/refs/tags/v$pkgver.tar.gz"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest \
		--deselect tests/test_gpgsign.py::test_gpgsign
}

package() {
	gpep517 install-wheel --destdir "$pkgdir" \
		.dist/*.whl
}
sha512sums="
0ac4643aad1bb41bd7127d03ba806c19e3db0d0e11f210a6107ba0500393c195b7403a4bb66c2b137a97b84b6b33e280efe11baeefc2ae0058c32f135cde10d7  git-revise-0.8.0.tar.gz
"
